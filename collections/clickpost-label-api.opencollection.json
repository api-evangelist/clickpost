{
  "opencollection": "1.0.0",
  "info": {
    "name": "ClickPost Cancellation Label API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Label",
        "type": "folder"
      },
      "items": [
        {
          "info": {
